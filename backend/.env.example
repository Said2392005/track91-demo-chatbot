MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=fleet_chatbot

# LLM provider — chat won't generate real answers without this. Without it, the app still
# starts and serves everything that doesn't need generation (greetings, clarifying questions,
# backlog-unsupported, out-of-scope) with a clear degraded message for anything that does.
# AWS Bedrock (app/llm/providers/bedrock.py) is the only provider; it reads credentials from
# boto3's default chain (~/.aws/credentials locally, IAM role in a container), never from this
# file — nothing to set here besides the provider name. Non-secret model/region default in
# app/core/config.py (bedrock_model_id/bedrock_region); override there or via env if needed.
LLM_PROVIDER=bedrock

# Caps completion tokens on every real LLM call. Lower = cheaper/faster but risks cutting off a
# legitimate longer answer mid-sentence. 500 was measured against the previous Bedrock model
# (gpt-oss-120b, which spent part of its completion-token budget on a hidden reasoning block —
# see docs/phase-12-testing/testing.md's token-usage section) and has NOT yet been re-verified
# against the current model (Nova Lite via Converse, app/core/config.py's bedrock_model_id) —
# see tests/test_max_tokens_real_bedrock.py's module docstring for the open item.
LLM_MAX_TOKENS=500

# Required for real deployments — no baked-in default, so a deployment that forgets to set
# this fails loudly rather than silently signing tokens with a well-known string.
JWT_SECRET_KEY=change-me-to-a-real-secret

LOG_LEVEL=INFO
