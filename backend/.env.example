MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fleet_chatbot

# LLM provider — chat won't generate real answers without this. Without it, the app still
# starts and serves everything that doesn't need generation (greetings, clarifying questions,
# backlog-unsupported, out-of-scope) with a clear degraded message for anything that does.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# Required for real deployments — no baked-in default, so a deployment that forgets to set
# this fails loudly rather than silently signing tokens with a well-known string.
JWT_SECRET_KEY=change-me-to-a-real-secret

LOG_LEVEL=INFO
